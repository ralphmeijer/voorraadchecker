# Kopieer dit bestand naar config.env en vul de waarden in.
# config.env bevat geheimen: niet delen, niet in git zetten.

# Bol.com Retailer API (verkopersaccount > Instellingen > API-instellingen)
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# Webserver
VC_HOST=127.0.0.1
VC_PORT=8768
# Zet op 1 zodra het dashboard achter HTTPS draait (op de VPS)
VC_COOKIE_SECURE=0
# Adres van het dashboard, voor de link in de weekmail
VC_BASE_URL=

# Weekmail (maandag). Leeg laten = geen mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Ontvangers, gescheiden door een komma
MAIL_TO=

# Amazon FBA via de Selling Partner API (koppeling volgt)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
